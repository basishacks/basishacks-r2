{
    "name": "basishacks",
    "type": "module",
    "private": true,
    "scripts": {
        "start": "cross-env NODE_ENV=production bun start-fix.mjs",
        "build": "cross-env NODE_OPTIONS=--no-deprecation nuxt build",
        "dev": "cross-env NODE_OPTIONS=--no-deprecation nuxt dev",
        "test": "vitest run --pool=forks",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "generate": "nuxt generate",
        "preview": "cross-env NODE_OPTIONS=--no-deprecation nuxt preview -p 24598",
        "postinstall": "nuxt prepare",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:js": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
        "format:html": "prettier --write \"**/*.html\"",
        "format:css": "prettier --write \"**/*.css\"",
        "format:json": "prettier --write \"**/*.json\"",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@comark/nuxt": "^0.4.0",
        "@iconify/utils": "^3.1.3",
        "@nuxt/eslint": "1.10.0",
        "@nuxt/fonts": "^0.14.0",
        "@nuxt/ui": "^4.9.0",
        "@vue/shared": "^3.5.39",
        "@vueuse/core": "^14.3.0",
        "@vueuse/shared": "^14.3.0",
        "better-sqlite3": "^12.11.1",
        "canvas-confetti": "^1.9.4",
        "comark": "^0.4.0",
        "drizzle-orm": "^0.44.7",
        "eslint": "^9.39.4",
        "gsap": "^3.15.0",
        "https-proxy-agent": "^9.1.0",
        "jdenticon": "^3.3.0",
        "jose": "^6.2.3",
        "node-fetch": "^3.3.2",
        "node-html-markdown": "^2.0.0",
        "nuxt": "^4.4.8",
        "nuxt-auth-utils": "0.5.25",
        "openai": "^6.45.0",
        "typescript": "^5.9.3",
        "vue": "^3.5.39",
        "vue-router": "^4.6.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@iconify-json/fluent": "^1.2.52",
        "@iconify-json/heroicons": "^1.2.3",
        "@iconify-json/lucide": "^1.2.115",
        "@iconify-json/material-symbols": "^1.2.82",
        "@iconify-json/simple-icons": "^1.2.88",
        "@types/better-sqlite3": "^7.6.13",
        "@types/bun": "^1.3.14",
        "@types/canvas-confetti": "^1.9.0",
        "@types/node": "^24.13.2",
        "@vitest/coverage-v8": "^4.1.9",
        "cross-env": "^10.1.0",
        "drizzle-kit": "^0.31.10",
        "prettier": "^3.9.5",
        "vitest": "^4.1.9"
    },
    "overrides": {
        "vite": "8.0.16",
        "entities": "7.0.1"
    }
}
