{
  "name": "basishacks",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "cross-env NODE_ENV=production bun start-fix.mjs",
    "build": "cross-env NODE_OPTIONS=--no-deprecation nuxt build",
    "build:bun": "node scripts/build-bun.mjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation nuxt dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate": "nuxt generate",
    "preview": "cross-env NODE_OPTIONS=--no-deprecation nuxt preview -p 24598",
    "postinstall": "nuxt prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:js": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "format:html": "prettier --write \"**/*.html\"",
    "format:css": "prettier --write \"**/*.css\"",
    "format:json": "prettier --write \"**/*.json\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@comark/nuxt": "^0.3.1",
    "@iconify/utils": "^3.1.3",
    "@nuxt/eslint": "1.10.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/ui": "^4.8.1",
    "@vue/shared": "^3.5.35",
    "@vueuse/core": "^14.3.0",
    "@vueuse/shared": "^14.3.0",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.44.7",
    "canvas-confetti": "^1.9.4",
    "comark": "^0.3.2",
    "eslint": "^9.39.4",
    "https-proxy-agent": "^9.0.0",
    "jdenticon": "^3.3.0",
    "jose": "^6.2.3",
    "node-fetch": "^3.3.2",
    "node-html-markdown": "^2.0.0",
    "nuxt": "^4.4.7",
    "nuxt-auth-utils": "0.5.25",
    "openai": "^6.42.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.35",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/fluent": "^1.2.48",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.111",
    "@iconify-json/material-symbols": "^1.2.76",
    "@iconify-json/simple-icons": "^1.2.85",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.7",
    "prettier": "^3.8.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "vite": "8.0.12"
  }
}
