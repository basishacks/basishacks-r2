# REQUIRED - Session encryption key, must be at least 32 bytes
# Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=random_string_at_least_32_bytes_long

# REQUIRED - Webhook/service URL for sending login verification codes
NUXT_SEND_CODE_URL=https://your-code-sending-service.com/send

# OPTIONAL - Microsoft Entra ID client secret for MS Graph API integration
# (Enables Microsoft OAuth2 login and MS Graph features like meeting scheduling)
# Get this from Azure Portal > App Registrations > basishacks app > Certificates & secrets
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# OPTIONAL - Microsoft Entra ID tenant ID (directory ID)
# Get this from Azure Portal > App Registrations > basishacks app > Overview
# Required together with MICROSOFT_CLIENT_ID for Microsoft OAuth2 login and MS Graph features
MICROSOFT_TENANT_ID=your_microsoft_tenant_id_here

# OPTIONAL - Microsoft Entra ID application (client) ID
# Get this from Azure Portal > App Registrations > basishacks app > Overview
# Required together with MICROSOFT_TENANT_ID for Microsoft OAuth2 login and MS Graph features
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here

# OPTIONAL - Base origin URL for OAuth2 redirect callbacks (no trailing slash)
# Must match the redirect URI registered in Azure Portal
# In production, set this to your actual domain (e.g., https://basishacks.com)
CURRENT_URL_ORIGIN=http://localhost:3000

# OPTIONAL - Microsoft OAuth2 redirect URI path (no origin, must start with /)
# Must exactly match the redirect URI registered in Azure Portal for the
# basishacks app. Defaults to /api/oauth2/mscallback. An alias handler is also
# exposed at /api/auth for convenience.
# Examples: /api/oauth2/mscallback  or  /api/auth
MICROSOFT_REDIRECT_URI=/api/oauth2/mscallback

# OPTIONAL - DeepSeek API key for AI chat features (debug routes only)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OPTIONAL - JWT signing secret for OAuth2 token exchange
# Generate with: openssl rand -base64 32
NUXT_OAUTH2_JWT_SECRET=your_oauth2_jwt_secret_here

# OPTIONAL - OAuth2 redirect URI path for the onsite basishacks login flow
# This is the path Microsoft-style apps redirect back to after authentication.
# It MUST be registered as a redirect URI for the OAuth2 application used by
# ONSITE_LOGIN_CLIENT_ID. Defaults to api/oauth2/dccallback.
# Do NOT set this to /api/auth; that path is reserved for the Microsoft OAuth2
# callback alias.
REDIRECT_URI=api/oauth2/dccallback

# REQUIRED for onsite login - OAuth2 client_id of the basishacks app used for the
# onsite login flow (/api/login -> /api/oauth2/authorize). Must be a registered
# OAuth2 application id (see /developers/applications).
ONSITE_LOGIN_CLIENT_ID=your_onsite_login_client_id_here

# OPTIONAL - ROPC test user credentials (rarely used, for testing only)
# MICROSOFT_DUMMY_USER_NAME=test_user@example.com
# MICROSOFT_DUMMY_USER_PASSWORD=test_password

# OPTIONAL - Server port/host override (defaults: port=3000, host=0.0.0.0)
# PORT=3000
# HOST=0.0.0.0
