# REQUIRED - Session encryption key, must be at least 32 bytes
# Generate with: openssl rand -base64 32 or node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NUXT_SESSION_PASSWORD=random_string_at_least_32_bytes_long

# REQUIRED - basis-auth OpenID Connect configuration
BASIS_AUTH_ISSUER=http://localhost:3000
BASIS_AUTH_CLIENT_ID=your_basis_auth_client_id_here
BASIS_AUTH_CLIENT_SECRET=your_basis_auth_client_secret_here
BASIS_AUTH_RESOURCE=urn:basis:api:basishacks


# OPTIONAL - Microsoft Entra ID tenant ID (directory ID)
# Get this from Azure Portal > App Registrations > basishacks app > Overview
# Required together with MICROSOFT_CLIENT_ID for MS Graph features
MICROSOFT_TENANT_ID=your_microsoft_tenant_id_here

# OPTIONAL - Microsoft Entra ID application (client) ID
# Get this from Azure Portal > App Registrations > basishacks app > Overview
# Required together with MICROSOFT_TENANT_ID for Graph features
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here

# OPTIONAL - Microsoft Entra ID client secret for MS Graph API integration
# Enables Graph features such as meeting scheduling and Teams chat
# Get this from Azure Portal > App Registrations > basishacks app > Certificates & secrets
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# OPTIONAL - Public basishacks origin used to derive the basis-auth callback URL
# `${CURRENT_URL_ORIGIN}/api/auth/basis/callback` must be registered in basis-auth.
# In production, set this to your actual domain (e.g., https://basishacks.com)
CURRENT_URL_ORIGIN=http://localhost:3000

# OPTIONAL - DeepSeek API key for AI chat features (debug routes only)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OPTIONAL - Server port/host override (defaults: port=3000, host=0.0.0.0)
# PORT=3000
# HOST=0.0.0.0

# OPTIONAL - ROPC test user credentials (rarely used, for testing only)
# MICROSOFT_DUMMY_USER_NAME=test_user@example.com
# MICROSOFT_DUMMY_USER_PASSWORD=test_password


# OPTIONAL - Rate limiting overrides (defaults shown)
# RATE_LIMIT_GENERAL_MAX=6000
# RATE_LIMIT_AUTH_MAX=600
# RATE_LIMIT_VOTE_MAX=600
# RATE_LIMIT_UPLOAD_MAX=600
# RATE_LIMIT_WINDOW_MS=60000


# OPTIONAL - Set to any truthy value when behind a trusted reverse proxy
# so x-forwarded-for is used for rate-limit client IP resolution
# TRUST_PROXY=true

# OPTIONAL - Set to any truthy value in production to disable /api/debug/* and /debug routes entirely
# DISABLE_DEBUG_ROUTES=true
